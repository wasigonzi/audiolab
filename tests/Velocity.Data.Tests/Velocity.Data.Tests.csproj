<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkPortable)</TargetFramework>
    <RootNamespace>Velocity.Data.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Velocity.Data\Velocity.Data.csproj" />
    <!-- The composition tests resolve the persistence layer the way a host does, which
         means going through the diagnostics package that supplies IVelocityPaths. -->
    <ProjectReference Include="..\..\src\Velocity.Diagnostics\Velocity.Diagnostics.csproj" />
    <ProjectReference Include="..\Velocity.TestSupport\Velocity.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
