<Window
    x:Class="Velocity.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Velocity">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar so the Mica backdrop runs edge to edge. -->
        <Grid x:Name="TitleBarArea" Height="44" Padding="16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="Velocity" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionStyle}"
                Text="{Binding SelectedItem.Title}" />

            <!-- Easy / Advanced / Expert -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    Content="Easy"
                    Command="{Binding SetModeCommand}"
                    CommandParameter="Easy"
                    Background="Transparent"
                    BorderThickness="0" />
                <Button
                    Content="Advanced"
                    Command="{Binding SetModeCommand}"
                    CommandParameter="Advanced"
                    Background="Transparent"
                    BorderThickness="0" />
                <Button
                    Content="Expert"
                    Command="{Binding SetModeCommand}"
                    CommandParameter="Expert"
                    Background="Transparent"
                    BorderThickness="0" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            MenuItemsSource="{Binding NavigationItems}"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItemTemplate>
                <DataTemplate>
                    <NavigationViewItem Content="{Binding Title}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{Binding Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- One honest banner about privileges, shown once for the whole application. -->
                <InfoBar
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    IsOpen="{Binding PrivilegeWarning, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Informational"
                    Message="{Binding PrivilegeWarning}" />

                <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
